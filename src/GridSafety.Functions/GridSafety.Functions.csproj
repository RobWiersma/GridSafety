    <PackageReference Include="Amazon.Lambda.CloudWatchEvents" Version="4.*" />
    <PackageReference Include="AWS.Lambda.Powertools.Logging" Version="*" />
    <PackageReference Include="AWS.Lambda.Powertools.Metrics" Version="*" />
    <PackageReference Include="AWS.Lambda.Powertools.Tracing" Version="*" />
    <PackageReference Include="Amazon.Lambda.APIGatewayEvents" Version="2.*" />
    <PackageReference Include="AWSSDK.ApiGatewayManagementApi" Version="4.*" />
    <PackageReference Include="AWSSDK.EventBridge" Version="4.*" />
    <PackageReference Include="AWSSDK.IoT" Version="4.*" />
    <PackageReference Include="AWSSDK.Lambda" Version="4.*" />
    <PackageReference Include="AWSSDK.IotData" Version="4.*" />
    <PackageReference Include="AWSSDK.Scheduler" Version="4.*" />
    <PackageReference Include="AWSSDK.SimpleNotificationService" Version="4.*" />
    <PackageReference Include="AWSSDK.S3" Version="4.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GridSafety.Core\GridSafety.Core.csproj" />
  </ItemGroup>
</Project>
